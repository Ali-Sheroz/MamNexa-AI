# ============================================================================
# MamNexa AI - environment configuration (EXAMPLE - safe to commit)
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values to enable the Supabase
# backend. `.env` is gitignored and must NEVER be committed.
#
#     cp .env.example .env      # then edit .env
#
# If these variables are absent, MamNexa AI runs in EPHEMERAL mode: analyses
# are kept only in process memory and vanish when the app closes. The full
# store / fetch / Right-to-Erasure semantics still work in that mode, so the
# demo runs completely offline.
# ============================================================================

# --- Supabase project credentials -------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# API key. For a local demo the anon/public key is sufficient; for server-side
# use a service_role key (KEEP SECRET - it bypasses row-level security).
SUPABASE_KEY=

# --- Optional: point the app at trained checkpoints WITHOUT renaming files --
# By default the app loads artifacts/models/efficientnetb0_baseline.keras and
# artifacts/models/unet.keras. Override either path here (see docs/MODEL_STATUS.md).
# MAMNEXA_CLASSIFIER_CHECKPOINT=
# MAMNEXA_SEGMENTER_CHECKPOINT=

# ----------------------------------------------------------------------------
# Expected Supabase setup (create these once in your project):
#   * PostgreSQL table `analyses` with at least:
#       id (text, primary key), created_at (timestamptz),
#       image_path (text), pdf_path (text)
#     plus the non-identifying scoring columns MamNexa writes
#     (suspicion_index, assessment, num_suspicious_regions, ...).
#   * Storage bucket `mamnexa-temp` for TEMPORARY image/PDF objects.
#
# Table and bucket names are configurable in src/config.py
# (SUPABASE_TABLE, SUPABASE_BUCKET) if you prefer different names.
# ----------------------------------------------------------------------------
